# =============================================================================
# Root Environment Configuration for Docker Compose
# =============================================================================

# Server settings
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production

# Database settings
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=written_db
MYSQL_USER=appuser
MYSQL_PASSWORD=change_this_app_password

# JWT & Authentication
JWT_SECRET=production-secret-min-32-chars-replace-in-real-deployment
JWT_EXPIRES_MINUTES=10080
JWT_ALGORITHM=HS256

# Networking & Ingress
CORS_ORIGINS=["http://localhost:3000","http://written-client:3000"]
VITE_API_URL=http://written-server:8080

# Image & Deployment Tagging (Day 3 CI/CD & Rollbacks)
IMAGE_TAG=latest
# For remote registries, e.g.:
# SERVER_IMAGE=ghcr.io/username/written-server
# CLIENT_IMAGE=ghcr.io/username/written-client
